/// Claims and billing data including payer, amounts charged, paid, denied, and claim status
table gold_financial
	lineageTag: 29d2f516-b79b-41fe-b451-87433597e410
	sourceLineageTag: [dbo].[gold_financial]

	measure 'Total Charges' = SUM(gold_financial[claim_amount])
		lineageTag: 4b4b45f5-3b91-47d8-bc5e-2f7c38b12c4b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Collections' = SUM(gold_financial[paid_amount])
		lineageTag: e02aace6-420d-4fc6-bd92-13e6f2f390ed

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Ratio of paid amount to total charges
	measure 'Collection Rate' =
			
			DIVIDE(
			    SUM(gold_financial[paid_amount]),
			    SUM(gold_financial[claim_amount]),
			    0
			)
		lineageTag: 0ce0d8e5-33a1-4b0b-9e38-bababca12bd5

		changedProperty = Name

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Percentage of claims denied by payer
	measure 'Denial Rate' =
			
			DIVIDE(
			    COUNTROWS(FILTER(gold_financial, gold_financial[claim_status] = "Denied")),
			    COUNTROWS(gold_financial),
			    0
			)
		lineageTag: 53bf966c-e588-402f-8d5c-d0f101697595

		changedProperty = Name

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue Lost to Denials' =
			
			CALCULATE(
			    SUM(gold_financial[claim_amount]),
			    gold_financial[claim_status] = "Denied"
			)
		lineageTag: 9902edd0-da99-499b-a46b-e32020363483

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

