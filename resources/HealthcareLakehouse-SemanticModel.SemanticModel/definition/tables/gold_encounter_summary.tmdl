/// Summary of all patient encounters including type (ED, Inpatient, Outpatient), facility, diagnosis, length of stay, and charges
table gold_encounter_summary
	lineageTag: bc9dce22-2d36-4aa6-afa8-e68b274ebf1f
	sourceLineageTag: [dbo].[gold_encounter_summary]

	measure 'Total Encounters' = COUNTROWS(gold_encounter_summary)
		formatString: 0
		lineageTag: f004dad2-eb53-4f71-9175-22a3819ffe34

		changedProperty = Name

	measure 'ED Visits' =
			
			COUNTROWS(FILTER(gold_encounter_summary, gold_encounter_summary[encounter_type] = "ED"))
		formatString: 0
		lineageTag: c9a42f9c-1f62-4499-9a9e-22b2cf8b5ddf

		changedProperty = Name

	measure 'Inpatient Admissions' =
			
			COUNTROWS(FILTER(gold_encounter_summary, gold_encounter_summary[encounter_type] = "Inpatient"))
		formatString: 0
		lineageTag: b5dca31b-e643-43be-b37c-5af926660700

		changedProperty = Name

	measure 'Avg Length of Stay' =
			
			CALCULATE(
			    AVERAGE(gold_encounter_summary[length_of_stay_days]),
			    gold_encounter_summary[encounter_type] = "Inpatient",
			    gold_encounter_summary[length_of_stay_days] > 0
			)
		lineageTag: 16d60505-7ad2-4eab-a213-a075b71c8002

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

