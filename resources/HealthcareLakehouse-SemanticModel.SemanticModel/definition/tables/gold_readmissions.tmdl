/// Contains 30-day readmission flags for all inpatient encounters, including index diagnosis, facility, and readmission status
table gold_readmissions
	lineageTag: 68fdd526-55e7-4ed3-8c56-ddae37e11c1a
	sourceLineageTag: [dbo].[gold_readmissions]

	/// Percentage of inpatient encounters followed by readmission within 30 days
	measure 'Readmission Rate' =
			
			DIVIDE(
			    COUNTROWS(FILTER(gold_readmissions, gold_readmissions[was_readmitted] = TRUE())),
			    COUNTROWS(gold_readmissions),
			    0
			)
		lineageTag: 45e24f83-422d-4458-a779-271166768268

		changedProperty = Name

		changedProperty = Description

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Readmissions' =
			
			COUNTROWS(FILTER(gold_readmissions, gold_readmissions[was_readmitted] = TRUE()))
		formatString: 0
		lineageTag: 52cde418-9b78-431e-b873-925f4cd578a4

		changedProperty = Name

	measure 'Total Index Admissions' = COUNTROWS(gold_readmissions)
		formatString: 0
		lineageTag: 8fd9747a-a318-46f7-8707-301f6ded5cd6

		changedProperty = Name

